{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "storyboard_version",
    "total_sections",
    "target_word_count",
    "sections",
    "motif_tracker",
    "emotional_arc_tracker",
    "continuity_requirements",
    "drafting_order"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "storyboard_version": {
      "type": "string"
    },
    "total_sections": {
      "type": "integer",
      "minimum": 1
    },
    "target_word_count": {
      "type": "integer",
      "minimum": 250
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_index",
          "section_title",
          "act_id",
          "summary",
          "purpose",
          "key_beats",
          "emotional_shift",
          "motifs",
          "continuity_obligations",
          "target_word_count",
          "drafting_constraints"
        ],
        "properties": {
          "section_index": {
            "type": "integer",
            "minimum": 1
          },
          "section_title": {
            "type": "string"
          },
          "act_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "key_beats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emotional_shift": {
            "type": "string"
          },
          "motifs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity_obligations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_word_count": {
            "type": "integer",
            "minimum": 1
          },
          "drafting_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "motif_tracker": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "motif",
          "introduced_in_section",
          "resolved_by_section"
        ],
        "properties": {
          "motif": {
            "type": "string"
          },
          "introduced_in_section": {
            "type": "integer",
            "minimum": 1
          },
          "resolved_by_section": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "emotional_arc_tracker": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_index",
          "emotional_state"
        ],
        "properties": {
          "section_index": {
            "type": "integer",
            "minimum": 1
          },
          "emotional_state": {
            "type": "string"
          }
        }
      }
    },
    "continuity_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drafting_order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
